# /etc/ssh3/ssh3-server.env - environment of the ssh3-server.service
# unit (read through EnvironmentFile).  Uncomment a line to override
# the built-in default; the full flag/env table lives in
# ssh3-server(8) and `ssh3-server --help`.

# Log level: debug | info | warn | error (default: info)
#SSH3_LOG_LEVEL=info

# Log file; empty/unset logs to stderr, which under systemd reaches
# the journal (the Debian default).
#SSH3_LOG_FILE=

# Seconds to drain the active conversations on SIGTERM before the
# close grace (default: 5; the unit budget is TimeoutStopSec=30s)
#SSH3_SHUTDOWN_DRAIN=5

# Password authentication: 0 turns it off (default on, the CGO crypt
# backend of the amd64 build against the unix accounts; the root
# account always refuses the password step).  The brute force stays
# bounded by SSH3_MAX_PASSWORD_FAILURES and
# SSH3_PASSWORD_LOCKOUT_SECONDS.
#SSH3_ENABLE_PASSWORD_LOGIN=0

# GatewayPorts policy for the reverse (-R) listeners:
# no (default) | yes | clientspecified
#SSH3_GATEWAY_PORTS=no
