# ssh3-server: systemd EnvironmentFile (instance configuration).
# Authentication: public keys by default (~/.ssh/authorized_keys or
# ~/.ssh3/authorized_identities of the target user). On amd64 builds the
# password backend is compiled in and enabled by default; set
# SSH3_ENABLE_PASSWORD_LOGIN=0 to turn it off. No OIDC configured.
# SSH3_ENABLE_PASSWORD_LOGIN=0
# Graceful shutdown: seconds to wait for active connections after SIGTERM
# before closing them (default 5, 0 = close immediately).
# SSH3_SHUTDOWN_DRAIN=5
SSH3_LOG_FILE=/var/log/ssh3.log
SSH3_LOG_LEVEL=info
# locale forwarded by the server to user shells
LANG=C.UTF-8
