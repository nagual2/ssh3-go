[Unit]
Description=SSH3 server (QUIC/HTTP-3, keys by default)
Documentation=https://github.com/nagual2/ssh3-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ssh3/ssh3-server.env
ExecStart=/usr/bin/ssh3-server -bind [::]:443 -cert /etc/ssh3/cert.pem -key /etc/ssh3/priv.key -url-path /ssh3-term
Restart=on-failure
RestartSec=3
# sshd parity: daemon restart must not kill active user sessions
KillMode=process
# OpenSSH-parity security model (per-session uid drop lives in
# util/unix_util/user.go: the root daemon spawns every session with the
# authenticated user's uid/gid). No sandbox directives here on purpose:
# CapabilityBoundingSet / NoNewPrivileges / Protect* / Restrict* apply to the
# whole cgroup, so they would clip capabilities that sudo regains inside a
# session — root could not run tcpdump, trafshow, modprobe or sysctl (EPERM),
# which OpenSSH sessions can. The trust boundary is key-based auth by
# default: password auth is compiled in on amd64 and enabled by default;
# -enable-password-login=false (or SSH3_ENABLE_PASSWORD_LOGIN=0 in
# /etc/ssh3/ssh3-server.env) turns it off. This mirrors Debian's ssh.service,
# which ships no such directives either.
[Install]
WantedBy=multi-user.target
